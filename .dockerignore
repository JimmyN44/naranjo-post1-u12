# Contexto de build = raiz del repositorio. El Dockerfile solo copia
# pedidos/pom.xml y pedidos/src; todo lo demas se excluye para que el
# contexto sea pequeno y ningun archivo local o sensible llegue al build.

# Salidas de compilacion y logs generados
**/target/
**/logs/
**/*.log

# Control de versiones y CI
.git/
.gitignore
.gitattributes
.github/

# IDEs y editores
.idea/
*.iml
*.iws
*.ipr
.vscode/
.classpath
.project
.settings/
.factorypath
.apt_generated/
.sts4-cache/
nbproject/

# Maven Wrapper (la imagen builder ya trae Maven)
**/.mvn/
**/mvnw
**/mvnw.cmd

# Archivos locales sensibles (variables, claves, configuracion local)
**/.env
**/.env.*
**/*.env
**/*.pem
**/*.key
**/*.p12
**/*.jks
**/application-local*.properties

# Temporales y del sistema operativo
**/*.tmp
**/*.swp
**/*~
**/.DS_Store
**/Thumbs.db

# Documentacion, capturas y archivos de Docker (no se necesitan en la imagen)
*.md
capturas/
docs/
Dockerfile
.dockerignore
